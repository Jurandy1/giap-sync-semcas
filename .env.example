# Copie para .env local ou Variables no Render (NÃO commitar .env)
API_KEY=troque-por-uma-chave-forte
SUPABASE_URL=https://isqslnnixdudhpunwnpx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-service-role
PUPPETEER_DOCKER=1
PORT=3000

# --- Otimização folha GIAP ---
# Meta de registros na folha antes de pular bulk (órgão + A–Z)
GIAP_BULK_META=400
GIAP_BULK_AZ_MIN_PENDENTES=30
# Buscas por nome por lote (Render free: 3; pode subir para 5/8/10)
GIAP_MAX_BUSCAS_NOME=3
GIAP_MAX_VARIANTES_NOME=4
GIAP_BULK_AZ=0
GIAP_BULK_PREFIXOS_MAX=15
# Reinício do Chrome (conservador no free tier)
GIAP_BROWSER_RESTART_EVERY=5
GIAP_CLOSE_BROWSER_EVERY_NOME=5
# Delay entre lotes encadeados (ms)
GIAP_CONTINUAR_DELAY_MS=5000
# Pressão de memória heap (0–1) para fechar Chrome antes de mais scrapes
GIAP_MEM_PRESSURE_RATIO=0.85
